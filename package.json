{
  "name": "frontend-project-template",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "sync:openapi": "pnpm --filter @template/api-client sync:openapi",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "3.9.5",
    "prettier-plugin-tailwindcss": "0.8.0",
    "turbo": "2.10.4"
  }
}
