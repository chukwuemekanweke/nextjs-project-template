{
  "extends": "@template/typescript-config/base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "types": ["node"]
  },
  "include": [".storybook/**/*", "src/**/*", "visual/**/*", "*.ts"],
  "exclude": ["node_modules", "storybook-static"]
}
