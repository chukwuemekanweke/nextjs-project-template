# Server-only configuration. Secrets belong here without a NEXT_PUBLIC_ prefix.
API_BASE_URL=http://localhost:8080
APP_ENVIRONMENT=development
APPLICATION_NAME=public-portal
APPLICATION_VERSION=0.1.0

# Browser-exposed configuration. Do not put secrets in these variables.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_APP_ENVIRONMENT=development
NEXT_PUBLIC_APPLICATION_NAME=public-portal
NEXT_PUBLIC_APPLICATION_VERSION=0.1.0
NEXT_PUBLIC_SITE_URL=http://localhost:3002
NEXT_PUBLIC_USER_PORTAL_URL=http://localhost:3000
NEXT_PUBLIC_PRODUCT_NAME=Acme Platform
NEXT_PUBLIC_ORGANIZATION_NAME=Acme Inc.
NEXT_PUBLIC_LOGO_LIGHT=/images/logo/logo-light.svg
NEXT_PUBLIC_LOGO_DARK=/images/logo/logo-dark.svg
NEXT_PUBLIC_FAVICON=/images/favicon.ico
NEXT_PUBLIC_BRAND_PRIMARY_COLOUR="#006BFF"
NEXT_PUBLIC_BRAND_ACCENT_COLOUR="#20C5A8"
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
NEXT_PUBLIC_COPYRIGHT=Acme Inc. All rights reserved.
NEXT_PUBLIC_USER_PORTAL_NAME=Customer Portal
NEXT_PUBLIC_ADMIN_PORTAL_NAME=Operations Portal
NEXT_PUBLIC_PUBLIC_PORTAL_NAME=Acme Platform
NEXT_PUBLIC_PRODUCT_DESCRIPTION=A configurable foundation for modern product teams.
NEXT_PUBLIC_CONTACT_ADDRESS=123 Product Street, Your City
