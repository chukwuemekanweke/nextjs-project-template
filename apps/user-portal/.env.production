# Production browser configuration, compiled into the Docker image by `next build`.
#
# Every value here is PUBLIC: Next.js inlines NEXT_PUBLIC_* values into the
# JavaScript sent to browsers. Only NEXT_PUBLIC_* keys are allowed in this file
# (enforced by src/config/production-build-env.test.ts). Never add secrets,
# tokens, private endpoints, or server-only values. Server-only configuration
# (API_BASE_URL, TENANT_ID, APP_ENVIRONMENT, ...) is supplied to the container at
# runtime by deploy/compose.production.yml and the host stack.env.
#
# Template placeholders: projects derived from this template replace the
# example.com hosts, client ID, and branding before their first release.
# .env.local (development and CI) takes precedence over this file.
NEXT_PUBLIC_API_BASE_URL=https://api.example.com
NEXT_PUBLIC_TENANT_ID=1203d9d1-2a6b-48ef-9cc1-e561a23aff72
NEXT_PUBLIC_APP_ENVIRONMENT=production
NEXT_PUBLIC_APPLICATION_NAME=user-portal
NEXT_PUBLIC_APPLICATION_VERSION=0.1.0
NEXT_PUBLIC_GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id.apps.googleusercontent.com
NEXT_PUBLIC_PRODUCT_NAME=Acme Platform
NEXT_PUBLIC_ORGANIZATION_NAME=Acme Inc.
NEXT_PUBLIC_LOGO_LIGHT=/images/logo/logo-light.svg
NEXT_PUBLIC_LOGO_DARK=/images/logo/logo-dark.svg
NEXT_PUBLIC_FAVICON=/images/favicon.svg
NEXT_PUBLIC_BRAND_PRIMARY_COLOUR="#006BFF"
NEXT_PUBLIC_BRAND_ACCENT_COLOUR="#20C5A8"
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
NEXT_PUBLIC_COPYRIGHT=Acme Inc. All rights reserved.
NEXT_PUBLIC_USER_PORTAL_NAME=Customer Portal
NEXT_PUBLIC_ADMIN_PORTAL_NAME=Operations Portal
NEXT_PUBLIC_PUBLIC_PORTAL_NAME=Acme Platform
NEXT_PUBLIC_USER_PORTAL_DESCRIPTION=Manage your account and product activity.
