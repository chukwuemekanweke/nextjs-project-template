# Non-secret stand-in for the host-owned <deployment-path>/stack.env.
#
# release-config-check.yml renders deploy/compose.production.yml with this file
# on every pull request. On the VPS, the operator creates the real stack.env
# (root-owned, not group/world writable) with the production values. Never put
# secrets, tokens, or credentials here or in the host file.

# Backend API origin as reachable from inside the portal containers (for
# example the public HTTPS API origin served by the host reverse proxy).
API_BASE_URL=https://api.example.com
TENANT_ID=1203d9d1-2a6b-48ef-9cc1-e561a23aff72
APP_ENVIRONMENT=production
ADMIN_REQUIRED_ROLE=Administrator

# Pinned subnet of this stack's portal network. The API's reverse proxy trusts
# this range for the browser IP the portals forward in X-Forwarded-For. Must not
# overlap another Docker network on the host (the backend uses 172.30.231.0/24).
# Changing it on a deployed host also requires renaming the Compose network.
PORTALS_SUBNET=172.30.232.0/24
PORTALS_GATEWAY=172.30.232.1
